# Gemini
GEMINI_API_KEY=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# YouTube Token
YOUTUBE_REFRESH_TOKEN=

# 기본 설정
PORT=3000

# Instagram Login (기존 Meta 개발자 앱의 Instagram API 설정값)
# 앱의 Instagram ID/Secret은 YouTube의 clientId/clientSecret과 별개입니다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram 앱 설정에 승인된 공개 HTTPS callback.
# 예시: https://your-tunnel.example/api/instagram-auth/callback
# HTTPS 터널은 PC의 http://localhost:3000 으로 전달되어야 합니다.
INSTAGRAM_REDIRECT_URI=
